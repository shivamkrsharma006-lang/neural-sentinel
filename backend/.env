# Copy this file to .env and fill in your values

# Security
SECRET_KEY=change-this-to-a-long-random-secret-key-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Twilio (optional - for SMS/call alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Webhook URLs (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1499399418149998693/HvLKt5ujgdxObu7P-iNwUKODnvW-2ehx1nASt8wN0Dn5kFOaizdKw5WK-hthBqe0zV0_
SLACK_WEBHOOK_URL=

# Detection settings
YOLO_MODEL=yolov8n.pt
DETECTION_CONFIDENCE=0.45
FACE_MATCH_THRESHOLD=0.55

# Risk score weights (must sum to 1.0)
RISK_WEIGHT_CONFIDENCE=0.3
RISK_WEIGHT_IDENTITY=0.4
RISK_WEIGHT_BEHAVIOR=0.3

# Alert cooldown (seconds between alerts per contact)
ALERT_COOLDOWN=30

# Gemini API Key (for future addons)
GEMINI_API_KEY=AQ.Ab8RN6J2sjLd2nriA2g8_gwRJLVM4-NFkGcZUMah_UgMt2utYQ
