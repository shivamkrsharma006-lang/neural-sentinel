# Copy this file to .env and fill in your values

# Security
SECRET_KEY=change-this-to-a-long-random-secret-key-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Twilio (optional - for SMS/call alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Webhook URLs (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Detection settings
YOLO_MODEL=yolov8n.pt
DETECTION_CONFIDENCE=0.45
FACE_MATCH_THRESHOLD=0.55

# Risk score weights (must sum to 1.0)
RISK_WEIGHT_CONFIDENCE=0.3
RISK_WEIGHT_IDENTITY=0.4
RISK_WEIGHT_BEHAVIOR=0.3

# Alert cooldown (seconds between alerts per contact)
ALERT_COOLDOWN=30
